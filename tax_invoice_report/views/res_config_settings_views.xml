<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="22"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_digitalization']" position="after">
                <div title="Government Fee Account:" id="gov_fee_account" class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="account_ocr_settings">
                        <div class="o_setting_right_pane" id="digitalizeocr">
<!--                            <label for="module_account_invoice_extract"/>-->
                            <label for="gov_fee_account_id" class="col-lg-4 o_light_label"/>
                            <field name="gov_fee_account_id"/>

<!--
                            <div class="text-muted">
                                Digitize your PDF or scanned documents with OCR and Artificial Intelligence
                            </div>
-->
                        </div>
                    </div>

<!--
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="gov_fee_account_id" class="col-lg-4 o_light_label"/>
                            <field name="gov_fee_account_id"/>
                        </div>
                    </div>
-->
                </div>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Enterprise app: allow cleartext for internal Odoo servers.
        Flutter's Dart HTTP bypasses this config, but native plugins
        (e.g. WebView, file downloads) respect it.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

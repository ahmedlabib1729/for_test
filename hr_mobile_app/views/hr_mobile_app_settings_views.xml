<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Vista de formulario للإعدادات -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="hr_mobile_app_settings_view_form" model="ir.ui.view">
        <field name="name">hr.mobile.app.settings.form</field>
        <field name="model">hr.mobile.app.settings</field>
        <field name="arch" type="xml">
            <form string="Mobile App Settings" class="oe_form_configuration">
                <header>
                    <button string="Save Settings" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Mobile App Configuration</h1>
                    </div>

                    <!-- القسم 1: الإعدادات العامة -->
                    <group string="General Settings">
                        <group>
                            <field name="allow_mobile_app_access" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <separator/>

                    <!-- القسم 2: معلومات الاتصال -->
                    <group string="Connection Settings">
                        <group>
                            <field name="api_base_url" placeholder="https://your-odoo-server.com" required="1"/>
                            <field name="api_database"/>
                        </group>
                        <group>
                            <field name="mobile_service_username"/>
                            <field name="mobile_service_password" password="True"/>
                        </group>
                    </group>

                    <separator/>

                    <!-- القسم 3: Token و QR Code -->
                    <group string="Mobile App Token and QR Code">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <strong>How it works:</strong><br/>
                            1. Click "Generate Token" to create a unique code<br/>
                            2. Share the QR Code or Short Code with employees<br/>
                            3. Employees scan/enter the code in the mobile app
                        </div>
                    </group>

                    <group>
                        <group string="Token Information">
                            <field name="company_token" readonly="1"
                                   placeholder="Click Generate Token to create"/>
                            <field name="company_code" readonly="1"
                                   placeholder="Auto-generated"/>
                            <field name="token_created_date" readonly="1"/>
                            <field name="token_expiry_date"/>
                        </group>
                        <group string="QR Code">
                            <field name="qr_code_image" widget="image" readonly="1"
                                   options="{'size': [200, 200]}"/>
                            <field name="connection_string" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>

                    <!-- أزرار التحكم -->
                    <group>
                        <div colspan="2">
                            <button name="action_generate_token"
                                    type="object"
                                    class="btn btn-primary me-2"
                                    string="Generate New Token"
                                    invisible="company_token"/>

                            <button name="action_regenerate_token"
                                    type="object"
                                    class="btn btn-warning me-2"
                                    string="Regenerate Token"
                                    invisible="not company_token"/>

                            <button name="action_revoke_token"
                                    type="object"
                                    class="btn btn-danger me-2"
                                    string="Revoke Token"
                                    invisible="not company_token"/>

                            <button name="action_copy_connection_string"
                                    type="object"
                                    class="btn btn-secondary"
                                    string="Show Connection String"
                                    invisible="not company_token"/>
                        </div>
                    </group>

                    <separator/>

                    <!-- تعليمات -->
                    <group string="Instructions for Employees">
                        <div class="alert alert-secondary" role="alert" colspan="2">
                            <h5>English:</h5>
                            <ol>
                                <li>Download the mobile app from App Store / Play Store</li>
                                <li>Open the app and choose "Setup"</li>
                                <li>Scan the QR Code OR enter the Short Code manually</li>
                                <li>Login with your employee credentials</li>
                            </ol>
                            <hr/>
                            <h5>العربية:</h5>
                            <ol>
                                <li>حمّل التطبيق من App Store / Play Store</li>
                                <li>افتح التطبيق واختر "إعداد"</li>
                                <li>امسح رمز QR أو أدخل الكود القصير يدوياً</li>
                                <li>سجل الدخول ببيانات الموظف الخاصة بك</li>
                            </ol>
                        </div>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Wizard تأكيد Token -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="hr_mobile_token_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.mobile.token.confirm.wizard.form</field>
        <field name="model">hr.mobile.token.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Token Regeneration">
                <group>
                    <div class="alert alert-warning" role="alert">
                        <h4>Warning!</h4>
                        <p>Regenerating the token will invalidate the current one.</p>
                        <p>All mobile apps will need to reconfigure.</p>
                    </div>
                    <field name="settings_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Yes, Regenerate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Action -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="action_hr_mobile_app_settings" model="ir.actions.act_window">
        <field name="name">Mobile App Settings</field>
        <field name="res_model">hr.mobile.app.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Menu Items -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_hr_mobile_app_settings"
              name="Mobile App Settings"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_mobile_app_settings"
              sequence="100"
              groups="hr.group_hr_manager"/>

</odoo>
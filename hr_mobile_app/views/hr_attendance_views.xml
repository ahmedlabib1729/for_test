<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- أضف هذا في ملف hr_mobile_app/views/hr_attendance_views.xml                 -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🆕 Form View محدث مع الصور -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="hr_attendance_view_form_photo" model="ir.ui.view">
            <field name="name">hr.attendance.form.photo</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <!-- إضافة تبويب للصور -->
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Verification Photos" name="photos">
                            <group>
                                <group string="Check-in Verification">
                                    <field name="check_in_photo" widget="image"
                                           class="oe_avatar"
                                           options="{'size': [300, 300]}"/>
                                    <field name="check_in_action"/>
                                    <field name="check_in_latitude"/>
                                    <field name="check_in_longitude"/>
                                </group>
                                <group string="Check-out Verification">
                                    <field name="check_out_photo" widget="image"
                                           class="oe_avatar"
                                           options="{'size': [300, 300]}"/>
                                    <field name="check_out_action"/>
                                    <field name="check_out_latitude"/>
                                    <field name="check_out_longitude"/>
                                </group>
                            </group>
                            <group>
                                <group string="Verification Status">
                                    <field name="face_verified"/>
                                    <field name="verification_method"/>
                                    <field name="location_verified"/>
                                    <field name="mobile_created"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🆕 Tree View مع أعمدة التحقق -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="hr_attendance_view_tree_photo" model="ir.ui.view">
            <field name="name">hr.attendance.tree.photo</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='worked_hours']" position="after">
                    <field name="face_verified" string="Face ✓"
                           widget="boolean_toggle"/>
                    <field name="location_verified" string="GPS ✓"
                           widget="boolean_toggle"/>
                    <field name="verification_method" string="Method"/>
                </xpath>
            </field>
        </record>



        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🆕 Action للحضور مع التحقق من الوجه -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="action_hr_attendance_face_verified" model="ir.actions.act_window">
            <field name="name">Face Verified Attendance</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">list,form,pivot,graph</field>
            <field name="context">{'search_default_face_verified': 1}</field>
            <field name="domain">[('face_verified', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No face-verified attendance records yet
                </p>
                <p>
                    Attendance records with face verification will appear here.
                </p>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🆕 Menu للحضور مع التحقق من الوجه -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <menuitem
            id="menu_hr_attendance_face_verified"
            name="Face Verified"
            action="action_hr_attendance_face_verified"
            sequence="25"/>

    </data>
</odoo>